{
  "tasks": {
    "dev": "deno run -A npm:@tauri-apps/cli dev",
    "build": "deno run -A npm:@tauri-apps/cli build",
    "fmt": "deno fmt src/ scripts/",
    "lint": "deno lint src/ scripts/",
    "vite": "deno run -A npm:vite",
    "storybook": "node node_modules/.bin/storybook dev -p 6006",
    "storybook-build": "node node_modules/.bin/storybook build",
    "test": "deno run -A npm:vitest run"
  },
  "imports": {
    "react": "npm:react@^19.2.6",
    "react-dom": "npm:react-dom@^19.2.6",
    "react/jsx-runtime": "npm:react@^19/jsx-runtime",
    "react/jsx-dev-runtime": "npm:react@^19/jsx-dev-runtime",
    "@types/react": "npm:@types/react@^19.2.14",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "@tauri-apps/api": "npm:@tauri-apps/api@^2",
    "@tauri-apps/plugin-opener": "npm:@tauri-apps/plugin-opener@^2",
    "@types/node": "npm:@types/node@^22.11.0",
    "vite": "npm:vite@^6.0.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.0.0",
    "tailwindcss": "npm:tailwindcss@^3.4.1",
    "postcss": "npm:postcss@^8.4.38",
    "autoprefixer": "npm:autoprefixer@^10.4.19",
    "tailwindcss-animate": "npm:tailwindcss-animate@^1.0.7",
    "clsx": "npm:clsx@^2.1.1",
    "tailwind-merge": "npm:tailwind-merge@^2.3.0",
    "lucide-react": "npm:lucide-react@^0.454.0",
    "shadcn": "npm:shadcn@^2.4.0",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@^1.2.4",
    "storybook": "npm:storybook@^8.0.0",
    "@storybook/react-vite": "npm:@storybook/react-vite@^8.0.0",
    "@storybook/react": "npm:@storybook/react@^8.0.0",
    "@storybook/addon-essentials": "npm:@storybook/addon-essentials@^8.0.0",
    "@storybook/addon-interactions": "npm:@storybook/addon-interactions@^8.0.0",
    "@storybook/addon-links": "npm:@storybook/addon-links@^8.0.0",
    "@storybook/addon-onboarding": "npm:@storybook/addon-onboarding@^8.0.0",
    "@storybook/blocks": "npm:@storybook/blocks@^8.0.0",
    "@storybook/test": "npm:@storybook/test@^8.0.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1",
    "vitest": "npm:vitest@^3.0.5",
    "jsdom": "npm:jsdom@^26.0.0",
    "@testing-library/react": "npm:@testing-library/react@^16.2.0",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^6.6.3",
    "@testing-library/jest-dom/vitest": "npm:@testing-library/jest-dom@^6.6.3/vitest"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@^19",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["npm:vite/client", "npm:@types/node", "npm:@types/react@^19", "npm:@types/react-dom"]
  },
  "fmt": {
    "exclude": ["dist", "src-tauri", "node_modules", ".vite"]
  },
  "lint": {
    "exclude": ["dist", "src-tauri", "node_modules", ".vite"]
  },
  "nodeModulesDir": "auto"
}
