{
  "tasks": {
    "dev": "deno run -A npm:@tauri-apps/cli dev",
    "build": "deno run -A npm:@tauri-apps/cli build",
    "fmt": "deno fmt src/ scripts/",
    "lint": "deno lint src/ scripts/",
    "vite": "deno run -A npm:vite",
    "storybook": "node node_modules/.bin/storybook dev -p 6006",
    "storybook-build": "node node_modules/.bin/storybook build",
    "test": "deno run -A npm:vitest run",
    "type-check": "deno check src/main.tsx"
  },
  "imports": {
    "react": "npm:react@19.2.6",
    "react-dom": "npm:react-dom@19.2.6",
    "react/jsx-runtime": "npm:react@19.2.6/jsx-runtime",
    "react/jsx-dev-runtime": "npm:react@19.2.6/jsx-dev-runtime",
    "@types/react": "npm:@types/react@19.2.15",
    "@types/react-dom": "npm:@types/react-dom@19.2.3",
    "@tauri-apps/api": "npm:@tauri-apps/api@2.11.0",
    "@tauri-apps/plugin-opener": "npm:@tauri-apps/plugin-opener@2.5.4",
    "@types/node": "npm:@types/node@22.19.19",
    "vite": "npm:vite@6.4.2",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@4.7.0",
    "tailwindcss": "npm:tailwindcss@3.4.19",
    "postcss": "npm:postcss@8.5.15",
    "autoprefixer": "npm:autoprefixer@10.5.0",
    "tailwindcss-animate": "npm:tailwindcss-animate@1.0.7",
    "clsx": "npm:clsx@2.1.1",
    "tailwind-merge": "npm:tailwind-merge@2.6.1",
    "class-variance-authority": "npm:class-variance-authority@0.7.1",
    "lucide-react": "npm:lucide-react@0.454.0",
    "shadcn": "npm:shadcn@2.10.0",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@1.2.4",
    "storybook": "npm:storybook@8.6.18",
    "@storybook/react-vite": "npm:@storybook/react-vite@8.6.18",
    "@storybook/react": "npm:@storybook/react@8.6.18",
    "@storybook/addon-essentials": "npm:@storybook/addon-essentials@8.6.14",
    "@storybook/addon-interactions": "npm:@storybook/addon-interactions@8.6.14",
    "@storybook/addon-links": "npm:@storybook/addon-links@8.6.18",
    "@storybook/addon-onboarding": "npm:@storybook/addon-onboarding@8.6.18",
    "@storybook/blocks": "npm:@storybook/blocks@8.6.14",
    "@storybook/test": "npm:@storybook/test@8.6.15",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@1.0.6",
    "vitest": "npm:vitest@3.2.4",
    "jsdom": "npm:jsdom@26.1.0",
    "@testing-library/react": "npm:@testing-library/react@16.3.2",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@6.9.1",
    "@testing-library/jest-dom/vitest": "npm:@testing-library/jest-dom@6.9.1/vitest"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@19.2.15",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["npm:vite@6.4.2/client", "npm:@types/node@22.19.19", "npm:@types/react@19.2.15", "npm:@types/react-dom@19.2.3"]
  },
  "fmt": {
    "exclude": ["dist", "src-tauri", "node_modules", ".vite"]
  },
  "lint": {
    "exclude": ["dist", "src-tauri", "node_modules", ".vite"]
  },
  "nodeModulesDir": "auto"
}
