{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevLog",
  "version": "0.1.0",
  "identifier": "dev.devlog",
  "build": {
    "beforeDevCommand": "deno task vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevLog",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; connect-src 'self' ipc:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
